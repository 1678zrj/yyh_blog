# 构建产物
site/
.build-cache/

# Python 虚拟环境与缓存
.venv/
__pycache__/
*.pyc

# 由 scripts/gen_blog.py 自动生成（源文件在 record/，日期清单在 note-dates.json）
docs/index.md
docs/blog/

# 本地资料目录（八股内容、爬取原文都不进公开仓库）
interview/*
# 但构建工具链要保留版本：换机器时不用重写爬虫、加密与校验脚本
!interview/tools/
# mkdocs blog 插件生成的临时分页目录（TEMP 环境变量异常时可能落在仓库根目录）
/tmp*/
